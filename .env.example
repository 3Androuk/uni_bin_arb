# Read-only Ethereum HTTP endpoint. Never commit a real key.
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/replace-me

# Required only for the optional pending-transaction collector.
ALCHEMY_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/replace-me

# Optional. These credentials are used only by Binance's signed, read-only
# tradeFee endpoint. No order endpoint exists in this project.
BINANCE_API_KEY=
BINANCE_API_SECRET=

